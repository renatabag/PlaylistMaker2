<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background">

    <View
        android:layout_width="@dimen/f0"
        android:layout_height="@dimen/four"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/activity_search_padding"
        android:background="@drawable/buttom_sheet_rectangle" />

    <!-- Вставленный item layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:layout_marginTop="12dp"
        tools:context=".presentation.ui.fragments.TrackPlayerFragment"
        style="@style/Base.Theme.PlaylistMakerr">

        <ImageView
            android:id="@+id/playlist_image"
            android:layout_width="@dimen/image_size"
            android:layout_height="@dimen/image_size"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_track"
            android:background="@android:color/transparent"
            android:transformPivotX="@dimen/very_small_padding"
            android:transformPivotY="@dimen/very_small_padding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/image_left"
            android:layout_marginTop="@dimen/activity_search_padding"
            android:layout_marginBottom="@dimen/activity_search_padding"/>

        <LinearLayout
            android:id="@+id/text_container"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@+id/playlist_image"
            app:layout_constraintTop_toTopOf="@+id/playlist_image"
            app:layout_constraintBottom_toBottomOf="@+id/playlist_image"
            android:layout_marginStart="@dimen/activity_search_padding">

            <TextView
                android:id="@+id/playlist_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_display_regular"
                android:gravity="center_vertical"
                android:text="@string/input_hint"
                android:textColor="@color/dark_white"
                android:textSize="@dimen/small_track_text_size"
                android:textStyle="bold"
                android:backgroundTint="@color/background"
                android:ellipsize="end"
                android:maxLines="1"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/one">

                <TextView
                    android:id="@+id/playlist_track_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ys_display_regular"
                    android:text="@string/input_hint"
                    android:textColor="@color/dark_white"
                    android:textSize="@dimen/small_text_track"
                    android:backgroundTint="@color/background"
                    android:ellipsize="end"
                    android:maxLines="1"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/share_playlist_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="start|center_vertical"
            android:textColor="@color/dark_white"
            android:text="Поделиться"
            android:textAllCaps="false"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="16dp"
            android:background="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/edit_information_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="start|center_vertical"
            android:background="@android:color/transparent"
            android:text="Редактировать информацию"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="16dp"
            android:textAllCaps="false"
            android:textColor="@color/dark_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/share_playlist_button" />

        <Button
            android:id="@+id/delete_playlist_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="start|center_vertical"
            android:background="@android:color/transparent"
            android:text="Удалить плейлист"
            android:textAllCaps="false"
            android:textColor="@color/dark_white"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_information_button" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>