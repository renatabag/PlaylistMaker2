<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/margine_track"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/playlist_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/playlist_image"
            android:layout_width="@dimen/picture_album"
            android:layout_height="@dimen/picture_album"
            android:src="@drawable/placeholder_track"
            android:scaleType="centerCrop"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/playlist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text"
            android:textColor="@color/dark_white"
            android:textSize="@dimen/o2"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/ys_display_regular"
            android:layout_marginTop="@dimen/four" />

        <TextView
            android:id="@+id/playlist_track_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text"
            android:textSize="@dimen/o4"
            android:textColor="@color/dark_white"
            android:maxLines="1"
            android:fontFamily="@font/ys_display_regular" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>